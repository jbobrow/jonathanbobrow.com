---
// Self-hosted from the @sveltia/cms npm package (installed as a
// devDependency) rather than the usual <script src="https://unpkg.com/...">
// snippet, so the editor doesn't depend on unpkg's uptime and there's one
// less third-party script origin. This only ships to visitors of /admin —
// it has no effect on the public site's bundle or Core Web Vitals.
import sveltiaCmsUrl from '@sveltia/cms?url';
// Loaded into the entry preview iframe via registerPreviewStyle below, so
// the preview pane picks up the site's actual classes/fonts instead of
// looking like a plain form. inlineStylesheets:'always' (astro.config.mjs)
// means the public pages no longer emit this as a standalone file, so it's
// imported here on its own to get a real built URL for the preview iframe.
import siteStyleUrl from '../../styles/style.css?url';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Content Manager — Jonathan Bobrow</title>
  <meta name="robots" content="noindex" />
</head>
<body>
  <!-- Reads /admin/config.yml (in public/admin/) and renders the editor here.
       The bundle registers window.CMS as a side effect of loading but does
       not auto-run — it must be started explicitly. -->
  <script is:inline src={sveltiaCmsUrl} type="module"></script>
  <!-- Astro-resolved asset URLs, handed to the bundled module script below
       via a global (define:vars only works on is:inline scripts). -->
  <script is:inline define:vars={{ siteStyleUrl }}>
    window.__ADMIN__ = { siteStyleUrl };
  </script>
  <script>
    import { registerVideoComponent } from './registerVideoComponent';
    import { registerProjectPreview } from './registerProjectPreview';

    registerVideoComponent(window.CMS);
    registerProjectPreview(window.CMS);
    window.CMS.registerPreviewStyle(window.__ADMIN__.siteStyleUrl);

    window.CMS.init();
  </script>
</body>
</html>
